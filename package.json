{
  "name": "pos-retail-desktop",
  "version": "0.1.0",
  "private": true,
  "description": "Windows Offline Retail Management and POS Desktop Application",
  "author": "Retail POS Desktop",
  "main": "dist-electron/main/main.js",
  "scripts": {
    "dev": "node scripts/dev.cjs",
    "dev:renderer": "vite",
    "dev:main": "tsc -p tsconfig.main.json",
    "build": "npm run prisma:generate && tsc -p tsconfig.renderer.json && vite build && tsc -p tsconfig.main.json",
    "package": "npm run build && electron-builder --win --dir",
    "package:installer": "npm run build && electron-builder --win",
    "prisma:generate": "prisma generate",
    "prisma:validate": "prisma validate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:seed": "prisma db seed",
    "db:clear": "node scripts/clear-db-data.cjs",
    "typecheck": "tsc -p tsconfig.renderer.json --noEmit && tsc -p tsconfig.main.json --noEmit"
  },
  "prisma": {
    "seed": "node scripts/seed.cjs"
  },
  "dependencies": {
    "@prisma/client": "^6.5.0",
    "jsbarcode": "^3.12.3",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/jsbarcode": "^3.11.4",
    "@types/node": "^22.13.0",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "cross-env": "^7.0.3",
    "electron": "^34.3.0",
    "electron-builder": "^25.1.8",
    "postcss": "^8.5.3",
    "prisma": "^6.5.0",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.3",
    "vite": "^6.2.0"
  },
  "build": {
    "appId": "com.pos.retaildesktop",
    "productName": "Retail POS Desktop",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "prisma/schema.prisma",
      "node_modules/.prisma/**/*",
      "node_modules/@prisma/client/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "node_modules/.prisma",
        "to": "node_modules/.prisma"
      },
      {
        "from": "node_modules/.prisma",
        "to": "app.asar.unpacked/node_modules/.prisma"
      },
      {
        "from": "node_modules/@prisma/client",
        "to": "node_modules/@prisma/client"
      },
      {
        "from": "prisma/schema.prisma",
        "to": "prisma/schema.prisma"
      }
    ],
    "asar": true,
    "asarUnpack": [
      "node_modules/.prisma/**/*",
      "node_modules/@prisma/**/*"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "deleteAppDataOnUninstall": false
    }
  }
}
